{
  "expo": {
    "name": "SGKS Notes",
    "slug": "shravanam-sgks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/acharya.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.sgks.shravanam"
    },
    "android": {
      "package": "org.sgks.shravanam"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "ప్రవచనాన్ని రికార్డ్ చేసి నోట్స్ తయారు చేయడానికి మైక్రోఫోన్ అవసరం. / The microphone is used to record the pravachanam and turn it into notes.",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/acharya.png",
          "resizeMode": "cover",
          "backgroundColor": "#F4EEE2",
          "imageWidth": 200
        }
      ]
    ]
  }
}