# Copy this file to .env and fill in your keys.

# ASR (speech-to-text). ASR_PROVIDER: dual (Sarvam V4 + Gemini, judged — recommended),
# gemini, sarvam or google. Sarvam is the backup for the single-service modes.
# There is no Whisper fallback: it dropped most of the speech on test recordings.
SARVAM_API_KEY=

# Optional: Gemini 3.5 Transcribe (the model family behind NotebookLM).
# Set ASR_PROVIDER=gemini to use it first; Sarvam and Whisper stay as fallbacks.
# ASR_PROVIDER=sarvam
# GEMINI_API_KEY=
# GEMINI_ASR_MODE=llm   # llm (keeps verses) | timestamps | vocabulary

# Groq LLM keys, one per pipeline step (separate keys spread the rate limits).
# The same key can be reused for all of them.
GROQ_API_KEY_SHLOKA=
GROQ_API_KEY_STRUCTURER=
GROQ_API_KEY_NOTES=          # used for the summary
GROQ_API_KEY_SPARE1=         # optional — tried when a step's key is rate-limited
GROQ_API_KEY_SPARE2=

# Optional: JS runtime yt-dlp uses for YouTube. Defaults to `node` on PATH.
# YTDLP_NODE_PATH=/usr/local/bin/node

# Optional: Groq model overrides (defaults: openai/gpt-oss-20b, openai/gpt-oss-120b)
# GROQ_FAST_MODEL=
# GROQ_STRONG_MODEL=

# Optional: Sarvam model settings (defaults: saaras:v3, transcribe, no keyterms)
# SARVAM_MODEL=saaras:v4
# SARVAM_MODE=verbatim          # transcribe | verbatim | codemix | translit
# SARVAM_KEYTERMS=1             # pass 50 Vaishnava terms as keyterms (saaras:v4 only)

# Optional: Google Cloud Speech-to-Text (Chirp 3). ASR_PROVIDER=google uses it first.
# Needs a service account with the "Cloud Speech Client" role on a billed project.
# GOOGLE_APPLICATION_CREDENTIALS=gcp-credentials.json
# GOOGLE_CLOUD_PROJECT=

# Optional: the 2–3 line summary (the notes are always the full verbatim transcript). 0 = off
# GENERATE_SUMMARY=1
