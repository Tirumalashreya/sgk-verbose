# Copy this file to .env and fill in your keys.

# ASR — Sarvam is primary; Groq Whisper is the fallback (at least one Whisper key is
# needed for the fallback to work). https://dashboard.sarvam.ai / https://console.groq.com
SARVAM_API_KEY=
GROQ_API_KEY_WHISPER=
GROQ_API_KEY_WHISPER2=

# Optional: Gemini 3.5 Transcribe (the model family behind NotebookLM).
# Set ASR_PROVIDER=gemini to use it first; Sarvam and Whisper stay as fallbacks.
# ASR_PROVIDER=sarvam
# GEMINI_API_KEY=
# GEMINI_ASR_MODE=llm   # llm (keeps verses) | timestamps | vocabulary

# Groq LLM keys, one per pipeline step (separate keys spread the rate limits).
# The same key can be reused for all of them.
GROQ_API_KEY_SHLOKA=
GROQ_API_KEY_STRUCTURER=
GROQ_API_KEY_NOTES=          # used for the summary
GROQ_API_KEY_SPARE1=         # optional — tried when a step's key is rate-limited
GROQ_API_KEY_SPARE2=

# Optional: JS runtime yt-dlp uses for YouTube. Defaults to `node` on PATH.
# YTDLP_NODE_PATH=/usr/local/bin/node

# Optional: Groq model overrides (defaults: openai/gpt-oss-20b, openai/gpt-oss-120b)
# GROQ_FAST_MODEL=
# GROQ_STRONG_MODEL=
